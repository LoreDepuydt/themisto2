{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug merge::tests::test_merge_shared_colors",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=themisto2",
                    "merge::tests::test_merge_shared_colors"
                ],
                "filter": {
                    "name": "themisto2",
                    "kind": "bin"
                }
            },
            "args": ["merge::tests::test_merge_shared_colors", "--exact", "--nocapture"],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "info"
            },
            "sourceLanguages": ["rust"]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug tests::test_parse_color_fof_rejects_empty_fields",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=themisto2",
                    "tests::test_parse_color_fof_rejects_empty_fields"
                ],
                "filter": {
                    "name": "themisto2",
                    "kind": "bin"
                }
            },
            "args": ["tests::test_parse_color_fof_rejects_empty_fields", "--exact", "--nocapture"],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "info"
            },
            "sourceLanguages": ["rust"]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug integration: file_colors_with_grouped_files_rejects_from_unitigs",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--test=integration"
                ],
                "filter": {
                    "name": "integration",
                    "kind": "test"
                }
            },
            "args": ["file_colors_with_grouped_files_rejects_from_unitigs", "--exact", "--nocapture"],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "info"
            },
            "sourceLanguages": ["rust"]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug all tests in merge.rs",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=themisto2",
                    "merge::tests::"
                ],
                "filter": {
                    "name": "themisto2",
                    "kind": "bin"
                }
            },
            "args": ["merge::tests::", "--nocapture"],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "info"
            },
            "sourceLanguages": ["rust"]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug themisto2 binary",
            "cargo": {
                "args": [
                    "build",
                    "--bin=themisto2"
                ],
                "filter": {
                    "name": "themisto2",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}
